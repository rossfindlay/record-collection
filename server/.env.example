# ── Backend (Railway) ────────────────────────────────────────────────────────

# PostgreSQL connection string — Railway injects this automatically when you
# link a Postgres plugin to the service.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# AES-256-GCM key for encrypting Discogs/Spotify tokens at rest.
# Must be at least 32 characters. Generate with: openssl rand -base64 32
ENCRYPTION_KEY="change-me-to-a-random-32-char-string!!"

# Comma-separated list of allowed CORS origins (the Vercel frontend URL).
# Example: https://record-collection.vercel.app
CORS_ORIGIN="https://record-collection.vercel.app"

# Port for the Express server (Railway sets PORT automatically).
PORT=8080
