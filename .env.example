# Railway PostgreSQL connection string
# On Railway this is injected automatically when you link a Postgres plugin.
# For local dev, run `npx prisma dev` for a local Postgres or provide your own URL.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Used to encrypt sensitive data (Discogs tokens, Spotify tokens) at rest.
# Must be at least 32 characters. Generate with: openssl rand -base64 32
ENCRYPTION_KEY="change-me-to-a-random-32-char-string!!"
